# ============================================================================
# Trump Offers — environment template
# Copy to `.env` and fill in. Then run: npm run env
# ============================================================================
#
# The Supabase anon / publishable key is designed for browser use and is
# protected by Row Level Security. NEVER put a service-role key in this file
# or in js/env.js — service-role keys bypass RLS and must stay server-side.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase anon / publishable key (safe for the browser)
SUPABASE_ANON_KEY=

# Canonical site origin used in auth email redirects
# Local: http://localhost:8080 — Production: https://trumpoffers.com
SITE_URL=http://localhost:8080

# true: local preview (development only) · false: Supabase production mode
DEMO_MODE=false

# Public support address shown in the footer and contact page
SUPPORT_EMAIL=concierge@trumpoffers.com

# Optional: hosted card-connection page from a PCI-compliant provider.
# When blank, members use the built-in manual payout-card form. The full card
# number is encrypted at rest in the private schema and revealed only to admins
# through an audited action. CVV, PIN and banking passwords are never collected.
CARD_CONNECT_URL=
CARD_PROVIDER=

# Optional: hosted bank-verification page, if your provider supplies one.
BANK_VERIFICATION_URL=

# Live chat (Brevo Conversations). Set LIVECHAT_ENABLED=false to disable it.
# The ID is public and is embedded in the chat widget loader.
LIVECHAT_ENABLED=true
BREVO_CONVERSATIONS_ID=6af29e2f9894c8cc930ccf0a
